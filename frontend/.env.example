# Pulse Web Frontend (Next.js) — copy to .env.local dan isi

# URL backend FastAPI
NEXT_PUBLIC_API_URL=http://localhost:8000

# Anthropic API key — dipakai server-side saja oleh app/api/ai-insight
# (Fase 4 AI Insight), TIDAK PERNAH diekspos ke client. Ambil di
# console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
