# Pulse Web Frontend (Next.js) — copy to .env.local dan isi

# URL backend FastAPI
NEXT_PUBLIC_API_URL=http://localhost:8000

# Gemini API key — dipakai server-side saja oleh app/api/ai-insight
# (Fase 4 AI Insight), TIDAK PERNAH diekspos ke client. Ambil di
# aistudio.google.com/apikey
GEMINI_API_KEY=

# Sentry (Fase 7 — error tracking). Kosongkan untuk disable — semua
# Sentry.init() di sini punya enabled: Boolean(dsn), jadi aman untuk
# local dev tanpa akun Sentry. SENTRY_DSN dipakai server/edge runtime,
# NEXT_PUBLIC_SENTRY_DSN untuk browser (harus sama value-nya).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Opsional — hanya untuk source map upload saat build produksi. Tanpa
# ini, withSentryConfig skip upload source map (tidak fatal).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
