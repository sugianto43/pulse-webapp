# Pulse Web Backend (FastAPI) — copy to .env dan isi

# Origin frontend Next.js yang boleh akses API ini (comma-separated kalau lebih dari satu)
PULSE_WEB_CORS_ORIGINS=http://localhost:3000

# Pulse-CLI core settings (prefix PULSE_, nested pakai __, lihat Pulse-CLI/.env.example)
PULSE_DATA__CACHE_TTL=3600
PULSE_DATA__DEFAULT_PERIOD=3mo

# Stockbit token (Fase 6 — Bandarmology/broker flow). Manual token,
# expired tiap ~24 jam — ambil dari browser DevTools > Network tab >
# Authorization header setelah login ke stockbit.com, refresh manual
# kalau /api/broker/{ticker} mulai gagal.
STOCKBIT_TOKEN=
